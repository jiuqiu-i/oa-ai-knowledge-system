# Server
NODE_ENV=development
PORT=3000
# 日志目录（容器内 /app/logs，本地 ./logs）
LOG_DIR=./logs

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=oa_knowledge_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=oa_ai_knowledge_system_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# 大模型（OpenAI 兼容协议，支持通义千问/MiniMax/DeepSeek 等）
# - 通义千问(DashScope): OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# - DeepSeek:            OPENAI_BASE_URL=https://api.deepseek.com/v1  OPENAI_MODEL=deepseek-chat
# - MiniMax:             OPENAI_BASE_URL=https://api.minimax.chat/v1
# - OpenAI:              留空 OPENAI_BASE_URL，使用 gpt-3.5-turbo/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=
OPENAI_TOP_P=

# 未配置 OPENAI_API_KEY 时，AI 接口返回模拟回复，便于本地开发与联调
